---
import '../styles/global.css';
import BulletList from '../components/BulletList.astro';
import SectionLabel from '../components/SectionLabel.astro';
import { bold } from '../lib/bold';
import { contact, education, experience, metaDescription, skills, summary } from '../data/cv';
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
  <title>{contact.name}, Software Engineer</title>
  <meta name="description" content={metaDescription} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
</head>
<body class="bg-page bg-paper-texture print:bg-none print:bg-white text-ink font-sans text-base leading-relaxed antialiased min-h-screen">

  <button
    id="print-btn"
    class="print:hidden fixed top-5 right-5 z-50 rounded-full border border-ink/20 text-ink bg-page/90 backdrop-blur px-4 py-2 text-sm font-semibold tracking-wide hover:bg-ink hover:text-page transition-colors"
  >
    Download PDF
  </button>

  <div class="mx-auto max-w-[620px] px-6 sm:px-8 py-16 sm:py-20 print:max-w-none print:m-0 print:p-0">

    <header class="reveal">
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-[1.02]">{contact.name}</h1>
      <div class="text-ink/70 font-semibold text-sm uppercase tracking-wide mt-2">{contact.role}</div>
      <div class="mt-4 text-sm text-muted flex flex-wrap gap-x-5 gap-y-1.5">
        <span>{contact.location}</span>
        <a href={`mailto:${contact.email}`} class="hover:text-ink transition-colors">{contact.email}</a>
        <span>{contact.phone}</span>
        <a href={contact.github} class="hover:text-ink transition-colors">github.com/whysetiawan</a>
        <a href={contact.linkedin} class="hover:text-ink transition-colors">linkedin.com/in/whysetiawan</a>
      </div>
    </header>

    <div class="reveal h-px bg-rule my-8 print:my-3.5"></div>

    <section class="reveal mb-10 print:mb-5">
      <p class="text-base text-ink/85" set:html={bold(summary)} />
    </section>

    <section class="reveal mb-10 print:mb-5">
      <SectionLabel>Experience</SectionLabel>

      {experience.map((job, i) => (
        <div
          class:list={[
            'print:pb-3 print:mb-3',
            !job.phases && 'print:break-inside-avoid',
            i < experience.length - 1 && 'pb-7 mb-7 border-b border-rule',
          ]}
        >
          <div class="flex justify-between items-baseline flex-wrap gap-x-4 gap-y-1 print:break-after-avoid">
            <span class="text-lg font-bold">{job.title}</span>
            <span class="text-xs text-faint whitespace-nowrap">{job.dates}</span>
          </div>
          {job.context && <div class="text-sm text-muted mt-1.5 mb-3">{job.context}</div>}
          {job.bullets && <BulletList items={job.bullets} class={!job.context ? 'mt-3' : undefined} />}
          {job.phases?.map((phase, p) => (
            <div class={p > 0 ? 'mt-5' : 'mt-1'}>
              <div class="text-xs font-bold uppercase tracking-wide text-ink/70 mb-2 print:break-after-avoid">{phase.label}</div>
              <BulletList items={phase.bullets} />
            </div>
          ))}
        </div>
      ))}
    </section>

    <div class="reveal h-px bg-rule my-8 print:my-3.5"></div>

    <section class="reveal mb-10 print:mb-5">
      <SectionLabel>Technical Skills</SectionLabel>
      <dl class="grid grid-cols-[100px_1fr] sm:grid-cols-[120px_1fr] gap-x-5 gap-y-2.5 text-sm">
        {skills.map(([label, value]) => (
          <Fragment>
            <dt class="font-bold text-ink/70">{label}</dt>
            <dd class="text-ink/80">{value}</dd>
          </Fragment>
        ))}
      </dl>
    </section>

    <div class="reveal h-px bg-rule my-8 print:my-3.5"></div>

    <section class="reveal">
      <SectionLabel>Education</SectionLabel>
      <div class="text-lg font-bold">{education.degree}</div>
      <div class="text-sm text-faint">{education.school}</div>
      <div class="text-sm font-bold text-ink mt-3">
        Thesis: <a href={education.thesisUrl} class="font-bold text-ink underline decoration-ink/30 hover:decoration-ink transition-colors">{education.thesisTitle}</a>
      </div>
      <BulletList items={[education.thesisNote]} class="mt-2" />
    </section>

  </div>

  <script>
    document.getElementById('print-btn')?.addEventListener('click', () => window.print());
  </script>
</body>
</html>
